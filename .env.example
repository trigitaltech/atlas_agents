# Copy to .env in this directory for Docker Compose.
POSTGRES_PASSWORD=atlas_local
DATABASE_URL=sqlite:///./platform.db
REDIS_URL=redis://localhost:6379/0
# Exact hostnames only; subdomains and redirect destinations require separate entries.
ALLOWED_DOMAINS=example.com
# Set a strong shared workspace token before exposing the API beyond localhost.
API_TOKEN=
OPENAI_API_KEY=
# Cloud: set OLLAMA_MODE=cloud and OLLAMA_URL=https://ollama.com (no /api suffix).
OLLAMA_MODE=local
OLLAMA_URL=http://host.docker.internal:11434
# Optional backend-only bearer credential for a compatible native Ollama HTTPS server.
# Leave empty for local Ollama; Cloud mode requires a backend API key.
OLLAMA_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
MAX_PAGES=50
MAX_TIMEOUT=600
MAX_TOKENS=20000
MAX_RESPONSE_BYTES=2000000
RATE_INTERVAL=1.0
BROWSER_ENABLED=false
QUEUE_EAGER=false
# Configure your own model's per-million-token prices. Zero means unpriced.
INPUT_COST_PER_MILLION=0
OUTPUT_COST_PER_MILLION=0
